APP_ENV=test
PORT=8080
ALLOWED_ORIGIN=http://localhost:5173
READ_TIMEOUT_SECONDS=5
DEBUG=false
SHUTDOWN_TIMEOUT_SECONDS=10
# PostgreSQL exclusivo para testes de integração.
POSTGRES_VERSION=18
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5435
POSTGRES_DB=foundry_stack_test
POSTGRES_USER=foundry_stack_test
POSTGRES_PASSWORD=foundry_stack_test
RESTART_POLICY=no

DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_BIND_ADDRESS}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
FOUNDRY_STACK_TEST_DATABASE_URL=${DATABASE_URL}

DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_IDLE_TIME_SECONDS=300
DB_CONN_MAX_LIFETIME_SECONDS=1800

# Substitua por um segredo de teste em base64 com pelo menos 32 bytes.
JWT_SECRET_BASE64=<valor-gerado>
JWT_ISSUER=foundry-stack-test
JWT_AUDIENCE=foundry-stack-api-test
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=172800
JWT_CLIENT_IDS=foundry-stack-test
# Transactional email (tests must not send real messages)
EMAIL_PROVIDER=memory
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@example.test
SMTP_FROM_NAME=FoundryStack
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT_SECONDS=10

# Use distinct test-only values with at least 32 decoded bytes.
EMAIL_VERIFICATION_CODE_SECRET_BASE64=<valor-de-teste-gerado>
EMAIL_VERIFICATION_CODE_TTL_SECONDS=900
EMAIL_VERIFICATION_TOKEN_SECRET_BASE64=<outro-valor-de-teste-gerado>
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
EMAIL_VERIFICATION_MAX_CONFIRM_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_RESEND_EMAIL_LIMIT_PER_HOUR=5
EMAIL_VERIFICATION_RESEND_IP_LIMIT_PER_HOUR=10
EMAIL_VERIFICATION_RETENTION_SECONDS=86400

# Use values distinct from each other and from email verification secrets.
PASSWORD_RESET_CODE_SECRET_BASE64=<valor-de-teste-gerado>
PASSWORD_RESET_CODE_TTL_SECONDS=900
PASSWORD_RESET_TOKEN_SECRET_BASE64=<outro-valor-de-teste-gerado>
PASSWORD_RESET_TOKEN_TTL_SECONDS=900
PASSWORD_RESET_MAX_CONFIRM_ATTEMPTS=5
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_EMAIL_LIMIT_PER_HOUR=5
PASSWORD_RESET_IP_LIMIT_PER_HOUR=10
PASSWORD_RESET_RETENTION_SECONDS=86400
TRUSTED_PROXY_CIDRS=
