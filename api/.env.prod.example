APP_ENV=prod
PORT=8080
ALLOWED_ORIGIN=https://example.com
READ_TIMEOUT_SECONDS=5
DEBUG=false
SHUTDOWN_TIMEOUT_SECONDS=10
# Database configuration
POSTGRES_VERSION=18
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_DB=foundry_stack
POSTGRES_USER=foundry_stack_prod
POSTGRES_PASSWORD=replace-this-password
RESTART_POLICY=unless-stopped
# Database connection pool settings
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_BIND_ADDRESS}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_IDLE_TIME_SECONDS=300
DB_CONN_MAX_LIFETIME_SECONDS=1800
# JWT configuration
APP_TOKEN=<valor-gerado>
JWT_SECRET_BASE64=<valor-gerado>
JWT_ISSUER=foundry-stack
JWT_AUDIENCE=foundry-stack-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=172800
JWT_CLIENT_IDS=foundry-stack-mobile,foundry-stack-swagger
# Transactional email
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=FoundryStack
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT_SECONDS=10

# Generate distinct secrets with: openssl rand -base64 32
EMAIL_VERIFICATION_CODE_SECRET_BASE64=<valor-gerado>
EMAIL_VERIFICATION_CODE_TTL_SECONDS=900
EMAIL_VERIFICATION_TOKEN_SECRET_BASE64=<outro-valor-gerado>
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
EMAIL_VERIFICATION_MAX_CONFIRM_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_RESEND_EMAIL_LIMIT_PER_HOUR=5
EMAIL_VERIFICATION_RESEND_IP_LIMIT_PER_HOUR=10
EMAIL_VERIFICATION_RETENTION_SECONDS=86400

# Generate values distinct from each other and from email verification secrets.
PASSWORD_RESET_CODE_SECRET_BASE64=<valor-gerado>
PASSWORD_RESET_CODE_TTL_SECONDS=900
PASSWORD_RESET_TOKEN_SECRET_BASE64=<outro-valor-gerado>
PASSWORD_RESET_TOKEN_TTL_SECONDS=900
PASSWORD_RESET_MAX_CONFIRM_ATTEMPTS=5
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_EMAIL_LIMIT_PER_HOUR=5
PASSWORD_RESET_IP_LIMIT_PER_HOUR=10
PASSWORD_RESET_RETENTION_SECONDS=86400
# Comma-separated CIDRs for explicitly trusted reverse proxies.
TRUSTED_PROXY_CIDRS=
